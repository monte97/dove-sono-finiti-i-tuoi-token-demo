{
 "uid": "token",
 "title": "I token, per agente",
 "schemaVersion": 39,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "",
 "templating": {
  "list": [
   {
    "name": "cartella",
    "type": "custom",
    "query": "strato-5,strato-5-correzione,strato-5-correzione-completa,strato-5-correzione-dialogo",
    "current": {
     "text": "strato-5",
     "value": "strato-5"
    },
    "options": [],
    "multi": false,
    "includeAll": false
   },
   {
    "name": "modo",
    "type": "custom",
    "query": "guasto,sana",
    "current": {
     "text": "guasto",
     "value": "guasto"
    },
    "options": []
   },
   {
    "name": "richiesta",
    "type": "textbox",
    "label": "richiesta (id sulle righe di log)",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "bargauge",
   "title": "Token di avvisi in una richiesta",
   "description": "L'istogramma assistente.agente.token, un valore per agente a fine richiesta: quante richieste in ogni secchio. Avvisi spende circa 17 mila token per volta che lavora.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (le) (max_over_time(assistente_agente_token_bucket{gen_ai_agent_name=\"avvisi\", banco_cartella=~\"$cartella\", banco_modo=\"$modo\"}[$__range]))",
     "format": "heatmap",
     "instant": true,
     "legendFormat": "{{le}}"
    }
   ],
   "options": {
    "orientation": "vertical",
    "displayMode": "basic",
    "showUnfilled": false,
    "valueMode": "text",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "#e8973a"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "bargauge",
   "title": "Token per agente, su tutte le richieste",
   "description": "I contatori gen_ai.client.inference.usage.input_tokens e output_tokens, sommati per gen_ai.agent.name.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sort_desc(sum by (gen_ai_agent_name) (max_over_time(gen_ai_client_inference_usage_input_tokens_total{banco_cartella=~\"$cartella\", banco_modo=\"$modo\"}[$__range])) + sum by (gen_ai_agent_name) (max_over_time(gen_ai_client_inference_usage_output_tokens_total{banco_cartella=~\"$cartella\", banco_modo=\"$modo\"}[$__range])))",
     "instant": true,
     "legendFormat": "{{gen_ai_agent_name}}"
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": false,
    "valueMode": "text",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "#606070"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "avvisi"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#e8973a"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Ogni richiesta, il suo exemplar",
   "description": "I punti sono gli exemplar dell'istogramma: il valore di una richiesta e la sua trace. Un clic apre la trace in Tempo.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(assistente_agente_token_bucket{gen_ai_agent_name=\"avvisi\", banco_cartella=~\"$cartella\", banco_modo=\"$modo\"}[5m])))",
     "exemplar": true,
     "range": true,
     "legendFormat": "avvisi, mediana"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "#e8973a"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "table",
   "title": "Token per agente in una richiesta, dai log",
   "description": "Le righe «chiamata al modello» di una richiesta (variabile richiesta: l'id sulla riga), sommate per agente.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 8,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "queryType": "instant",
     "instant": true,
     "expr": "sum by (agente) (sum_over_time({service_name=\"osservare-a-strati\"} | richiesta=\"$richiesta\" | unwrap input_tokens [$__range]))",
     "legendFormat": "{{agente}}"
    }
   ],
   "transformations": [
    {
     "id": "reduce",
     "options": {
      "reducers": [
       "lastNotNull"
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "logs",
   "title": "Le righe di una richiesta",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 8,
    "y": 17,
    "w": 16,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service_name=\"osservare-a-strati\"} | richiesta=\"$richiesta\""
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": false,
    "sortOrder": "Ascending",
    "enableLogDetails": true
   }
  }
 ]
}
