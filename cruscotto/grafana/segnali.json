    {
     "refId": "richieste",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "metricsQueryType": "range",
     "query": "{ span.banco.cartella =~ \"$cartella\" && span.banco.modo = \"$modo\" } | count_over_time()",
     "step": "60s"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "sum"
     ],
     "fields": "",
     "values": false
    },
