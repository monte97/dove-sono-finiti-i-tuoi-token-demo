  {
   "id": 2,
   "type": "stat",
   "title": "valida approva",
   "description": "Archi verso valida il cui risultato apre o chiude con «Verificato.», su tutti i verdetti: dagli span, non dal riassunto.",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "refId": "approvati",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "metricsQueryType": "range",
     "query": "{ span.banco.cartella =~ \"$cartella\" && span.banco.modo = \"$modo\" } >> { span.gen_ai.transfer.target.name = \"valida\" && span.gen_ai.tool.call.result =~ \"(?s)[\\\\s\\\"'«*]*Verificato\\\\..*|.*Verificato\\\\.[\\\\s\\\"'»*]*\" } | count_over_time()",
     "step": "60s"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "sum"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "colorMode": "none",
    "graphMode": "none",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0
    },
    "overrides": []
   }
  },
