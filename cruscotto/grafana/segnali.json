      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "metricsQueryType": "range",
     "query": "{ span.banco.cartella = \"$cartella\" && span.banco.modo = \"$modo\" } | count_over_time()",
