     "refId": "approvati",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "metricsQueryType": "range",
     "query": "{ span.banco.cartella = \"$cartella\" && span.banco.modo = \"$modo\" } >> { span.gen_ai.transfer.target.name = \"valida\" && span.gen_ai.tool.call.result =~ \"(?s).*Verificato\\\\.[\\\\s\\\"'»*]*\" } | count_over_time()",
     "step": "60s"
