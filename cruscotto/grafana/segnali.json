  {
   "id": 9,
   "type": "stat",
   "title": "valida approva",
   "description": "Archi verso valida il cui risultato chiude con «Verificato.», su tutti i verdetti: dagli span, non dal riassunto.",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 4,
